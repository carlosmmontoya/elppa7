<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:id="@+id/main"

    >


    <TextView
        android:id="@+id/nombrechat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/blue"
        app:layout_constraintTop_toTopOf="parent"

        android:text="holaque tal como essasdf la sdñljfña"

        />



    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/nombrechat"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        android:paddingTop="90dp"


        >

        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/nombrechat"
            app:layout_constraintBottom_toTopOf="@+id/linearLayout"
            android:paddingBottom="100dp"


            android:fitsSystemWindows="true"




            />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>






    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="horizontal"
        android:background="#ffffff"

        android:fitsSystemWindows="true"


        >


        <EditText
            android:id="@+id/texsent2"
            android:layout_width="255dp"
            android:layout_height="wrap_content"
            android:hint="@string/scrivi"
            android:background="@color/white"
            android:backgroundTintMode="multiply"
            android:padding="10dp"
            android:layout_margin="1dp"
            />
        <Button
            android:id="@+id/enviar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/botonedentificate"
            android:padding="10dp"
            android:layout_margin="1dp"
            />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>